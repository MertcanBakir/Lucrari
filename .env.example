# Lucrari Supabase Environment Configuration
# NOTE: In Expo React Native, client-accessible environment variables must start with EXPO_PUBLIC_
# NEVER include Supabase SERVICE_ROLE_KEY or any secret admin credentials here.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# Modern Supabase Publishable Key (Recommended: starts with sb_publishable_)
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# Legacy Supabase Anon JWT Key (Fallback: must have role: 'anon')
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# FinBot Analysis Backend (HTTPS only; do not put service-role or provider secrets here)
EXPO_PUBLIC_ANALYSIS_API_URL=https://analysis.example.com

# Optional Android Firebase client config path (use an EAS file environment variable for builds).
# Not an FCM server/service-account key. Never use EXPO_PUBLIC_ for server credentials.
# GOOGLE_SERVICES_JSON=/absolute/path/to/google-services.json
